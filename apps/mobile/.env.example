EXPO_PUBLIC_API_URL=http://localhost:3000
# 배포 시: https://<your-vercel-app>.vercel.app
# 실기기(iPhone) 테스트: http://<Mac LAN IP>:3000 (예: http://192.168.0.10:3000)

# (선택) Clerk 도입 전 dev 식별용 UUID. 비워두면 앱이 처음 실행될 때
# SecureStore 에 새 UUID 를 만들어 저장한다 — web/mobile 동일 user 로 묶고 싶을 때만 채워 사용.
EXPO_PUBLIC_DEV_USER_ID=

# TFLite 분류기 사용 여부. true 면 react-native-fast-tflite 로 실제 추론, false 면 mock.
# 모델 .tflite 파일을 assets/models/ 에 두기 전까지는 false 로 둔다.
EXPO_PUBLIC_USE_REAL_TFLITE=false
