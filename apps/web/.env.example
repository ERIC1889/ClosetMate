# Database (Neon Postgres via Vercel Marketplace)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...
# 모델 ID 는 OpenAI 카탈로그 변동에 대비해 환경변수로 분리한다.
# 실제 ID 는 https://platform.openai.com/docs/models 에서 최신 확인 후 채울 것.
# 기획에 정의된 nano-first + mini fallback 정책을 그대로 따른다.
# 비워두면 코드가 보수적인 기본값(gpt-4o-mini / gpt-4o)으로 떨어진다 — 실험 단계에서만 허용.
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_FALLBACK=
OPENAI_MODEL_TRANSCRIBE=

# Fallback 임계값 (model_confidence < 이 값이면 mini fallback)
LLM_CONFIDENCE_THRESHOLD=0.7

# Weather
OPENWEATHER_API_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Clerk (선택 — MVP 에서는 헤더 기반 임시 인증을 사용)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dev only — Clerk 도입 전 임시 사용자 식별용. UUID 형식.
# 프로덕션 빌드에서는 무시된다.
DEV_FAKE_USER_ID=
